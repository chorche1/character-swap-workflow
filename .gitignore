.env
.venv/
__pycache__/
*.pyc
*.pyo
.pytest_cache/
.ruff_cache/
.DS_Store
.local/

# User-supplied inputs and pipeline artifacts
characters/*
!characters/.gitkeep
input/*
!input/.gitkeep
output/*
!output/.gitkeep
state/*
!state/.gitkeep

# uv
uv.lock

# Remotion: never commit Node modules or the built preview bundle
remotion/node_modules
web/static/remotion-preview.js
web/static/remotion-preview.js.map

# generated guide artifacts (keep the .md source)
WORKFLOWS_GUIDE.pdf
WORKFLOWS_GUIDE.html
.claude/scheduled_tasks.lock

# swap-engine eval outputs (scripts/swap_eval.py)
eval_out/

# A stray empty DB the test suite can drop in the repo root when STATE_DIR
# resolves to "." — never a real artifact (the real one lives in state/ or
# ~/character-swap-data/state/, see CLAUDE.md "Shared data store").
state.sqlite3
state.sqlite3-shm
state.sqlite3-wal
db.sqlite3
db.sqlite3-shm
db.sqlite3-wal
